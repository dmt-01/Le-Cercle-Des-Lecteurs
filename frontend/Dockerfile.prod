# ─── Stage 1 : Build ──────────────────────────────────────────────────────────
# Installe les dépendances et compile le projet React en fichiers statiques
FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json pnpm-lock.yaml ./
RUN npm install -g pnpm && pnpm install

COPY . .

# VITE_API_BASE_URL est une variable Vite : elle doit être connue AU MOMENT DU BUILD
# car Vite l'injecte directement dans le bundle JavaScript (pas à l'exécution)
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN pnpm run build

# ─── Stage 2 : Serve ──────────────────────────────────────────────────────────
# Image nginx légère qui sert les fichiers statiques générés
FROM nginx:alpine

# Copie le build React dans le dossier servi par nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Remplace la config nginx par défaut par notre config SPA
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
