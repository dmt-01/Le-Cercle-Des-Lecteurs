# ─── Base de données ──────────────────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
# Dev uniquement (pour exposer la BDD en local) :
# POSTGRES_PORT=5432
DATABASE_URL=postgresql://your_db_user:your_db_password@db:5432/your_db_name

# ─── Adminer (dev + preprod uniquement) ───────────────────────────────────────
ADMINER_PORT=8080

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=3000
BACKEND_JWT_REFRESH_SECRET=your_very_long_secret_key
BACKEND_JWT_REFRESH_TTL=604800
BACKEND_CORS_ALLOWED=http://localhost:5173

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
FRONTEND_VITE_API_BASE_URL=http://localhost:3000/api
